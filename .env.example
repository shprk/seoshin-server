DATABASE_URL=postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:PORT/postgres
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
PORT=PORT_NUMBER
CORS_ORIGIN=http://localhost:PORT
ADMIN_EMAIL=EMAIL_ADRESS
ADMIN_PASSWORD=change-me
# prisma db seed는 Task 테이블을 전부 지운다. 원격 DB에 실행하려면 true로 설정.
ALLOW_REMOTE_SEED=false
